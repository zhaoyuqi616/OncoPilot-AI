# Never commit real secrets. Inject them through your deployment secret manager.
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=6
MAX_TOP_K=12
MAX_QUESTION_CHARS=4000
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=40
REQUEST_TIMEOUT_SECONDS=45
WORKSPACE_DATA_ROOT=data/workspaces
WORKSPACE_ARTIFACT_ROOT=artifacts/workspaces
TRACE_DIR=artifacts/traces
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
OCR_ENABLED=true
OCR_MIN_NATIVE_CHARS_PER_PAGE=40
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
AUTH_MODE=dev
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
ALLOW_EXTERNAL_LLM_FOR_SENSITIVE=false
SENSITIVE_LABELS=phi,restricted
TRACE_STORE_QUESTION=false
ALLOWED_ORIGINS=http://localhost:7860,http://localhost:8000
